{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Git Auto Pull",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "while ($true) { if (-not (git status --porcelain)) { git pull --ff-only }; Start-Sleep -Seconds 15 }"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "panel": "dedicated"
            }
        }
    ]
}