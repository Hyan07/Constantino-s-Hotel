# AMBIENTE DA APLICAÇÃO: development, staging ou production
APP_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
TRUST_PROXY=0

# MYSQL LOCAL / HOSTINGER
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=constantinos_hotel_local
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Use uma chave aleatória longa e diferente em cada ambiente (mínimo 32 caracteres)
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Opcional. Use nomes diferentes se DEV e produção compartilharem domínio.
SESSION_COOKIE_NAME=

# SMTP PARA RECUPERAÇÃO DE SENHA
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Constantino's Hotel <nao-responda@constantinoshotel.com>

# PRIMEIRO ADMINISTRADOR (remova da Hostinger após o primeiro bootstrap)
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_CPF=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
